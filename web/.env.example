# ---- App ----
# local = personal use: no credits, limits, billing, pricing or geo-block; "/" opens the studio.
# prod  = public SaaS (default).
APP_ENV=prod
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Forma3D
# Legal entity operating the service (shown to users; required by Hunyuan3D license §3e)
NEXT_PUBLIC_OPERATOR_NAME="Your Company LLC"

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forma3d

# Signs /api/files URLs. openssl rand -base64 32
FILE_URL_SECRET=

# ---- Auth (Firebase Authentication) ----
# Firebase console > Project settings > General > Your apps (Web app). Enable Email/Password (+ Google) sign-in providers.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Project settings > Service accounts > Generate new private key (keep the \n escapes in the private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Admin CMS (/app/admin): settings, model downloads ----
# Comma-separated emails. Accounts must have a verified email (Firebase sends the verification link).
ADMIN_EMAILS=

# ---- Storage ----
# Uploaded inputs + generated models are plain files in STORAGE_DIR (default: data/outputs next to web/),
# served through signed /api/files URLs.
# STORAGE_DIR=../data/outputs

# ---- Generation backend: self-hosted Hunyuan3D worker (see ../worker, started by ../start.sh on :8081) ----
HUNYUAN_WORKER_URL=
HUNYUAN_WORKER_TOKEN=
# Optional second engine: Hunyuan3D-2.1 worker (ENGINE=2.1, same token). Adds a 2.0 / 2.1 picker to the studio.
# HUNYUAN21_WORKER_URL=http://localhost:8082

# ---- Billing (VietQR bank transfer, confirmed manually in /app/admin/payments) ----
# Bank BIN or short name from https://api.vietqr.io/v2/banks (e.g. 970436 or VCB), account number, account holder name.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# ---- Limits (defaults; the admin CMS can override these at runtime) ----
SIGNUP_CREDITS=10
MAX_ACTIVE_JOBS_PER_USER=2
JOB_TIMEOUT_MINUTES=30
# Comma-separated ISO country codes to block. Default = EU + GB + KR (license Territory).
# BLOCKED_COUNTRIES=

# Protects /api/cron/sweep (Vercel Cron sends it as Bearer token). Required in production.
CRON_SECRET=
